{
  "name": "write-this-down",
  "version": "1.1.0",
  "description": "Write This Down: a minimal, private Markdown notepad",
  "scripts": {
    "build": "NODE_ENV=production gulp default",
    "dev": "NODE_ENV=development gulp dev",
    "test": "node --test test/csp.test.mjs test/chrome.test.mjs test/share.test.mjs test/markdown.test.mjs test/names.test.mjs test/tidy.test.mjs test/seo.test.mjs test/pages.test.mjs test/licenses.test.mjs test/i18n.test.mjs test/background.test.mjs test/editor.test.mjs test/folder.test.mjs test/documents.test.mjs test/bridge-protocol.test.mjs test/bridge-reconcile.test.mjs test/bridge-journal.test.mjs",
    "test:browser": "node test/browser/run.mjs",
    "test:browser:build": "node test/browser/check.mjs",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "test:extension": "node --test test/extension.test.mjs && node test/extension/run.mjs",
    "test:bridge": "node --test test/bridge-protocol.test.mjs test/bridge-reconcile.test.mjs test/bridge-database.test.mjs test/bridge-journal.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdiezsj/write-this-down.git"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://rdiezsj.github.io/write-this-down/",
  "private": true,
  "browserslist": "> 0.25%, not dead",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "del": "^8.0.1",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.2.0",
    "gulp-sass": "^6.0.1",
    "sass": "^1.77.0",
    "webpack": "^5.90.0",
    "webpack-stream": "^7.0.0"
  }
}
