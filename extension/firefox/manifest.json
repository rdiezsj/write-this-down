{
  "manifest_version": 3,
  "name": "Write this down!",
  "version": "1.1.3",
  "description": "Un editor de notas Markdown privado y local.",
  "icons": {
    "16": "sidebar-16.png",
    "32": "sidebar-32.png",
    "192": "android-chrome-192x192.png"
  },
  "sidebar_action": {
    "default_title": "Write this down!",
    "default_icon": {
      "16": "sidebar-16.png",
      "32": "sidebar-32.png"
    },
    "default_panel": "index.html",
    "open_at_install": false
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://writethisdown.eu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Write this down!",
    "default_icon": {
      "16": "sidebar-16.png",
      "32": "sidebar-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wtd@writethisdown.eu",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
