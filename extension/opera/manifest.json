{
  "manifest_version": 3,
  "name": "Write this down!",
  "version": "1.1.2",
  "description": "Un editor de notas Markdown privado y local.",
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png",
    "192": "android-chrome-192x192.png"
  },
  "sidebar_action": {
    "default_title": "Write this down!",
    "default_icon": {
      "16": "sidebar-16.png",
      "32": "sidebar-32.png"
    },
    "default_panel": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://writethisdown.eu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
